<?xml version="1.0"?>
<package format="2">
  <name>mineguard_robot</name>
  <version>0.1.0</version>
  <description>MineGuard C1 four-wheel simulation robot for user-supplied Gazebo worlds.</description>
  <maintainer email="mineguard@example.invalid">MineGuard contributors</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>gazebo_dev</build_depend>
  <depend>roscpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <export>
    <gazebo_ros plugin_path="${prefix}/../../lib"/>
  </export>
</package>
