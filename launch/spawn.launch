<launch>
  <arg name="model_name" default="mineguard"/>
  <arg name="x" default="0"/>
  <arg name="y" default="0"/>
  <arg name="z" default="0.03"/>
  <arg name="yaw" default="0"/>
  <arg name="turn_scale" default="2.0"/>
  <param name="mineguard/course_turn_scale" value="$(arg turn_scale)" type="double"/>
  <group ns="mineguard">
    <param name="robot_description" textfile="$(find mineguard_robot)/urdf/mineguard_c1.urdf"/>
    <node pkg="gazebo_ros" type="spawn_model" name="spawn_robot"
          args="-urdf -param robot_description -model $(arg model_name) -x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw)" output="screen"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>
  </group>
</launch>
