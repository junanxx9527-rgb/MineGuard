<?xml version='1.0' encoding='utf-8'?>
<robot name="mineguard">
  <material name="amber">
    <color rgba="0.93 .48 .06 1" />
  </material>
  <material name="graphite">
    <color rgba=".10 .13 .16 1" />
  </material>
  <material name="silver">
    <color rgba=".55 .58 .6 1" />
  </material>
  <link name="base_footprint" />
  <joint name="footprint_fixed" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 .18" />
  </joint>
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="20" />
      <inertia ixx="0.283333" ixy="0" ixz="0" iyy="0.642667" iyz="0" izz="0.840667" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mineguard_robot/meshes/base_link.dae" />
      </geometry>
    </visual>
    <collision name="base_link_collision">
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.6 0.38 0.16" />
      </geometry>
    </collision>
  </link>
  <link name="front_left_wheel">
    <inertial>
      <mass value="1.5" />
      <inertia ixx="0.00665" ixy="0" ixz="0" iyy="0.0108" iyz="0" izz="0.00665" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mineguard_robot/meshes/front_left_wheel.dae" />
      </geometry>
    </visual>
    <collision name="front_left_wheel_collision">
      <origin rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".12" length=".10" />
      </geometry>
    </collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="front_left_wheel" />
    <origin xyz="0.23 0.24 -.06" />
    <axis xyz="0 1 0" />
    <limit effort="12" velocity="12" />
    <dynamics damping="0" friction="0" />
  </joint>
  <gazebo reference="front_left_wheel">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>500000</kp>
    <kd>20</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>
  <link name="front_right_wheel">
    <inertial>
      <mass value="1.5" />
      <inertia ixx="0.00665" ixy="0" ixz="0" iyy="0.0108" iyz="0" izz="0.00665" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mineguard_robot/meshes/front_right_wheel.dae" />
      </geometry>
    </visual>
    <collision name="front_right_wheel_collision">
      <origin rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".12" length=".10" />
      </geometry>
    </collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="front_right_wheel" />
    <origin xyz="0.23 -0.24 -.06" />
    <axis xyz="0 1 0" />
    <limit effort="12" velocity="12" />
    <dynamics damping="0" friction="0" />
  </joint>
  <gazebo reference="front_right_wheel">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>500000</kp>
    <kd>20</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>
  <link name="rear_left_wheel">
    <inertial>
      <mass value="1.5" />
      <inertia ixx="0.00665" ixy="0" ixz="0" iyy="0.0108" iyz="0" izz="0.00665" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mineguard_robot/meshes/rear_left_wheel.dae" />
      </geometry>
    </visual>
    <collision name="rear_left_wheel_collision">
      <origin rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".12" length=".10" />
      </geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_left_wheel" />
    <origin xyz="-0.23 0.24 -.06" />
    <axis xyz="0 1 0" />
    <limit effort="12" velocity="12" />
    <dynamics damping="0" friction="0" />
  </joint>
  <gazebo reference="rear_left_wheel">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>500000</kp>
    <kd>20</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>
  <link name="rear_right_wheel">
    <inertial>
      <mass value="1.5" />
      <inertia ixx="0.00665" ixy="0" ixz="0" iyy="0.0108" iyz="0" izz="0.00665" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mineguard_robot/meshes/rear_right_wheel.dae" />
      </geometry>
    </visual>
    <collision name="rear_right_wheel_collision">
      <origin rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius=".12" length=".10" />
      </geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_right_wheel" />
    <origin xyz="-0.23 -0.24 -.06" />
    <axis xyz="0 1 0" />
    <limit effort="12" velocity="12" />
    <dynamics damping="0" friction="0" />
  </joint>
  <gazebo reference="rear_right_wheel">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>500000</kp>
    <kd>20</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>
  <link name="sensor_deck">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.00526833" ixy="0" ixz="0" iyy="0.00326833" iyz="0" izz="0.00845333" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mineguard_robot/meshes/sensor_deck.dae" />
      </geometry>
    </visual>
    <collision name="sensor_deck_collision">
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.22 0.28 0.025" />
      </geometry>
    </collision>
  </link>
  <joint name="sensor_deck_fixed" type="fixed">
    <parent link="base_link" />
    <child link="sensor_deck" />
    <origin xyz="-0.1 0 0.105" />
  </joint>
  <link name="lidar_pedestal">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.4" />
      <inertia ixx="0.000580833" ixy="0" ixz="0" iyy="0.000580833" iyz="0" izz="0.000201667" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mineguard_robot/meshes/lidar_pedestal.dae" />
      </geometry>
    </visual>
    <collision name="lidar_pedestal_collision">
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.055 0.055 0.12" />
      </geometry>
    </collision>
  </link>
  <joint name="lidar_pedestal_fixed" type="fixed">
    <parent link="base_link" />
    <child link="lidar_pedestal" />
    <origin xyz="-0.1 0 0.18" />
  </joint>
  <link name="lidar">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.6" />
      <inertia ixx="0.00104" ixy="0" ixz="0" iyy="0.00104" iyz="0" izz="0.00144" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mineguard_robot/meshes/lidar.dae" />
      </geometry>
    </visual>
    <collision name="lidar_collision">
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.12 0.12 0.08" />
      </geometry>
    </collision>
  </link>
  <joint name="lidar_fixed" type="fixed">
    <parent link="base_link" />
    <child link="lidar" />
    <origin xyz="-0.1 0 0.28" />
  </joint>
  <link name="front_bumper">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.6" />
      <inertia ixx="0.0102763" ixy="0" ixz="0" iyy="0.0002525" iyz="0" izz="0.0102263" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mineguard_robot/meshes/front_bumper.dae" />
      </geometry>
    </visual>
    <collision name="front_bumper_collision">
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.045 0.45 0.055" />
      </geometry>
    </collision>
  </link>
  <joint name="front_bumper_fixed" type="fixed">
    <parent link="base_link" />
    <child link="front_bumper" />
    <origin xyz="0.33 0 -0.005" />
  </joint>
  <link name="rear_bumper">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.6" />
      <inertia ixx="0.0102763" ixy="0" ixz="0" iyy="0.0002525" iyz="0" izz="0.0102263" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mineguard_robot/meshes/rear_bumper.dae" />
      </geometry>
    </visual>
    <collision name="rear_bumper_collision">
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.045 0.45 0.055" />
      </geometry>
    </collision>
  </link>
  <joint name="rear_bumper_fixed" type="fixed">
    <parent link="base_link" />
    <child link="rear_bumper" />
    <origin xyz="-0.33 0 -0.005" />
  </joint>
  <link name="camera">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.000684375" ixy="0" ixz="0" iyy="0.00016875" iyz="0" izz="0.000684375" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mineguard_robot/meshes/camera.dae" />
      </geometry>
    </visual>
    <collision name="camera_collision">
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.045 0.12 0.045" />
      </geometry>
    </collision>
  </link>
  <joint name="camera_fixed" type="fixed">
    <parent link="base_link" />
    <child link="camera" />
    <origin xyz="0.25 0 0.1" />
  </joint>
  <link name="left_rail">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.25" />
      <inertia ixx="2.60417e-05" ixy="0" ixz="0" iyy="0.00702135" iyz="0" izz="0.00702135" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mineguard_robot/meshes/left_rail.dae" />
      </geometry>
    </visual>
    <collision name="left_rail_collision">
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.58 0.025 0.025" />
      </geometry>
    </collision>
  </link>
  <joint name="left_rail_fixed" type="fixed">
    <parent link="base_link" />
    <child link="left_rail" />
    <origin xyz="0 0.202 0.075" />
  </joint>
  <link name="right_rail">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.25" />
      <inertia ixx="2.60417e-05" ixy="0" ixz="0" iyy="0.00702135" iyz="0" izz="0.00702135" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://mineguard_robot/meshes/right_rail.dae" />
      </geometry>
    </visual>
    <collision name="right_rail_collision">
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.58 0.025 0.025" />
      </geometry>
    </collision>
  </link>
  <joint name="right_rail_fixed" type="fixed">
    <parent link="base_link" />
    <child link="right_rail" />
    <origin xyz="0 -0.202 0.075" />
  </joint>
  <gazebo>
    <plugin name="mineguard_effort_drive" filename="libmineguard_course_drive.so" />
    <plugin name="wheel_states" filename="libgazebo_ros_joint_state_publisher.so">
      <robotNamespace>/mineguard</robotNamespace>
      <updateRate>30</updateRate>
      <jointName>front_left_wheel_joint,front_right_wheel_joint,rear_left_wheel_joint,rear_right_wheel_joint</jointName>
    </plugin>
  </gazebo>
  <gazebo reference="lidar">
    <sensor name="lidar_3d" type="ray">
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.1328660073298216</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.7853981633974483</min_angle>
            <max_angle>0.7853981633974483</max_angle>
          </vertical>
        </scan>
        <range>
          <min>.30</min>
          <max>25</max>
          <resolution>.02</resolution>
        </range>
      </ray>
      <plugin name="mineguard_lio_lidar" filename="libmineguard_lio_lidar.so" />
    </sensor>
  </gazebo>
  <gazebo reference="camera">
    <sensor name="mapping_rgbd" type="depth">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>8</update_rate>
      <camera>
        <horizontal_fov>1.4</horizontal_fov>
        <image>
          <width>480</width>
          <height>320</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>.15</near>
          <far>12</far>
        </clip>
      </camera>
      <plugin name="mapping_rgbd_ros" filename="libgazebo_ros_openni_kinect.so">
        <robotNamespace>/mineguard</robotNamespace>
        <cameraName>front</cameraName>
        <alwaysOn>true</alwaysOn>
        <updateRate>0</updateRate>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <depthImageTopicName>depth/image_raw</depthImageTopicName>
        <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
        <pointCloudTopicName>depth/points</pointCloudTopicName>
        <frameName>/camera_optical</frameName>
        <pointCloudCutoff>.3</pointCloudCutoff>
        <pointCloudCutoffMax>10</pointCloudCutoffMax>
      </plugin>
    </sensor>
  </gazebo>
  <link name="camera_optical" />
  <joint name="camera_optical_fixed" type="fixed">
    <parent link="camera" />
    <child link="camera_optical" />
    <origin rpy="-1.57079632679 0 -1.57079632679" />
  </joint>
  <link name="lio_imu" />
  <joint name="lio_imu_fixed" type="fixed">
    <parent link="lidar" />
    <child link="lio_imu" />
    <origin xyz="0 0 0" />
  </joint>
  <gazebo reference="lio_imu">
    <sensor name="lio_imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>250</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>.001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>.001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>.001</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>.02</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>.02</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>.02</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="mineguard_lio_imu" filename="libgazebo_ros_imu_sensor.so">
        <robotNamespace>/mineguard</robotNamespace>
        <topicName>imu/data</topicName>
        <frameName>lio_imu</frameName>
        <updateRateHZ>1000</updateRateHZ>
        <gaussianNoise>0</gaussianNoise>
        <initialOrientationAsReference>false</initialOrientationAsReference>
      </plugin>
    </sensor>
  </gazebo>
  <link name="lio_lidar" />
  <joint name="lio_lidar_frame" type="fixed">
    <parent link="lidar" />
    <child link="lio_lidar" />
  </joint>
</robot>